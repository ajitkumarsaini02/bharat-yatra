node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production Builds
dist/
dist-ssr/
build/
.vite/

# Logs & Diagnostics
logs/
*.log
*.tmp
*.temp
.cache/

# OS & Editor Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
